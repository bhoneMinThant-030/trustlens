# Copy to ai/.env and fill in. Never commit .env.
AWS_REGION=ap-southeast-2

# Bedrock model IDs: copy exactly what the Sydney model catalog shows.
# If a call fails with "on-demand throughput isn't supported", use the
# cross-region inference profile ID instead (starts with apac. or au.).
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
ANSWER_MODEL_ID=amazon.nova-lite-v1:0
CHECKER_MODEL_ID=anthropic.claude-haiku-5-5

# Search index
S3_BUCKET=trustlens-kb-change-me
S3_INDEX_KEY=index.json
